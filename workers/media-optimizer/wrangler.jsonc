{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qserve-media-optimizer",
  "main": "./index.js",
  "compatibility_date": "2026-09-20",
  "r2_buckets": [
    {
      "binding": "QSERVE_PROJECTS",
      "bucket_name": "qserve-video-editor"
    }
  ],
  "media": {
    "binding": "MEDIA"
  }
}
